# Muninn — environment configuration
# Copy to .env and edit. Never commit .env.

# ── Storage paths (override defaults) ─────────────────────────────
# Defaults: ./raw/ for source files, ./data/ for derived artifacts.
# MUNINN_RAW_DIR=/opt/muninn/raw
# MUNINN_DATA_DIR=/opt/muninn/data

# ── Database ──────────────────────────────────────────────────────
# Defaults to $MUNINN_DATA_DIR/muninn.db.
# MUNINN_DB_PATH=/opt/muninn/data/muninn.db

# ── Anthropic API (Haiku bulk enrichment) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Scrape etiquette ──────────────────────────────────────────────
# Contact URL advertised in the scraper's User-Agent string.
# MUNINN_CONTACT_URL=https://your-contact-page.example
# Seconds a cached live response is reused (default 86400); `muninn scrape
# --refresh` bypasses the live cache. Archive snapshots are cached forever.
# MUNINN_LIVE_CACHE_TTL_SECONDS=86400

# ── X API (muninn x auth / muninn ingest x) ───────────────────────
# OAuth 2.0 settings of your own X developer app. The secret is only for a
# confidential client. Tokens are never put here: `muninn x auth` writes
# them to MUNINN_X_TOKEN_FILE (default $MUNINN_DATA_DIR/x-tokens.json, 0600).
# MUNINN_X_CLIENT_ID=
# MUNINN_X_CLIENT_SECRET=
# MUNINN_X_REDIRECT_URI=http://127.0.0.1:8765/callback
# MUNINN_X_TOKEN_FILE=/opt/muninn/data/x-tokens.json

# ── Research Intake (muninn enrich --task suitability / export packets) ──
# Your real interest profile is personal: keep it outside the repo
# (e.g. in the dotprivate sidecar). interest_profile.example.yml shows the format.
# MUNINN_INTEREST_PROFILE=/path/to/interest_profile.yml
# MUNINN_SUITABILITY_MODEL=claude-haiku-4-5-20251001
# MUNINN_PACKETS_DIR=/opt/muninn/data/packets

# ── Search backend (ADR-014) ──────────────────────────────────────
# MUNINN_SEARCH_BACKEND=fts5-qdrant

# ── Qdrant (vector index, homelab LXC) ────────────────────────────
QDRANT_URL=http://192.168.86.19:6333
QDRANT_COLLECTION=muninn_bookmarks

# ── Embeddings (semantic index) ───────────────────────────────────
# Backend: sentence-transformers (default; local EmbeddingGemma — needs
# `pip install 'muninn[embeddings]'`) or hash (deterministic offline
# placeholder — never ship search on it).
# MUNINN_EMBEDDING_BACKEND=sentence-transformers
# MUNINN_EMBEDDING_MODEL=google/embeddinggemma-300m
# MUNINN_EMBEDDING_DIM=768

# ── Vault (Obsidian-compatible compiled output) ───────────────────
# ROOT of the compiled vault repo (muninn-vault checkout). The compiler
# writes pages into $MUNINN_VAULT_DIR/wiki/bookmarks/.
MUNINN_VAULT_DIR=/path/to/muninn-vault

# Personal vault — guard against MUNINN_VAULT_DIR matching this.
# The generator REFUSES to write if these resolve to the same path.
# (See SPEC.md Decision 2: two vaults, never one.)
MUNINN_PERSONAL_VAULT_DIR=/path/to/personal-vault

# ── Synthesis (docs/synthesis-contract.md) ────────────────────────
# `muninn synthesize era|deep-pass|analyze` runs the task with the direct
# API runner (ANTHROPIC_API_KEY above). It refuses to spend without a
# monthly cap; the per-run cap is --max-cost-usd (default $3.00).
# --emit-task DIR writes the task file for another harness instead, and
# spends nothing.
MUNINN_SYNTHESIS_MONTHLY_BUDGET_USD=10
# Model for the API runner (default claude-opus-5-5; must be priced in
# muninn.enrich.pricing). --model overrides it.
# MUNINN_SYNTHESIS_MODEL=claude-opus-5-5
# Effort: low | medium | high | xhigh | max (default high).
# MUNINN_SYNTHESIS_EFFORT=high

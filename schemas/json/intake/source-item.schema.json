{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muninn:research-intake:source-item:0.1",
  "title": "Source item",
  "description": "One captured item: an X post, an X Article (proposed), a GitHub repository or a web page. Maps onto a bookmarks row (UNIQUE(source, source_id)). Linked items are separate source items joined by item-link records, never merged into their parent.",
  "type": "object",
  "required": ["record_type", "item_id", "kind", "locator", "title", "published_at", "redaction"],
  "additionalProperties": false,
  "properties": {
    "record_type": { "const": "source-item" },
    "item_id": { "$ref": "urn:muninn:research-intake:defs:0.1#/$defs/item_id" },
    "kind": { "enum": ["x_post", "x_article", "github_repo", "web_page"] },
    "locator": {
      "description": "Sanitized canonical locator (bookmarks.url), or null when sanitization rejected every candidate.",
      "oneOf": [
        { "$ref": "urn:muninn:research-intake:defs:0.1#/$defs/locator" },
        { "type": "null" }
      ]
    },
    "title": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 1000 },
        { "type": "null" }
      ]
    },
    "published_at": {
      "description": "Source publication time, when the source states one. Never inferred from the bookmark time.",
      "oneOf": [
        { "$ref": "urn:muninn:research-intake:defs:0.1#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "author": {
      "description": "X authors only. Null when the API returned no author (deleted or suspended).",
      "oneOf": [
        {
          "type": "object",
          "required": ["platform_id"],
          "additionalProperties": false,
          "properties": {
            "platform_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
            "handle": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$" },
            "display_name": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        { "type": "null" }
      ]
    },
    "x_post": {
      "description": "X post details from the API response (kind x_post only).",
      "type": "object",
      "required": ["is_long_post"],
      "additionalProperties": false,
      "properties": {
        "conversation_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "is_long_post": {
          "description": "True when the text came from note_tweet.",
          "type": "boolean"
        },
        "has_media": { "type": "boolean" },
        "possibly_sensitive": { "type": "boolean" }
      }
    },
    "repository": {
      "description": "GitHub repository coordinates (kind github_repo only), lowercase as in item_id.",
      "type": "object",
      "required": ["owner", "name"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,38}$" },
        "name": { "type": "string", "pattern": "^[a-z0-9._-]{1,100}$" }
      }
    },
    "redaction": {
      "description": "What sanitize_url removed from the original locator (names and flags only, never values).",
      "type": "object",
      "required": ["param_names", "path_redacted", "userinfo_redacted"],
      "additionalProperties": false,
      "properties": {
        "param_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "path_redacted": { "type": "boolean" },
        "userinfo_redacted": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "x_post" } } },
      "then": { "properties": { "item_id": { "pattern": "^x:post:" } } },
      "else": { "not": { "required": ["x_post"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "x_article" } } },
      "then": { "properties": { "item_id": { "pattern": "^x:article:" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "github_repo" } } },
      "then": {
        "required": ["repository"],
        "properties": { "item_id": { "pattern": "^github:repo:" } }
      },
      "else": { "not": { "required": ["repository"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "web_page" } } },
      "then": { "properties": { "item_id": { "pattern": "^web:" } } }
    },
    {
      "if": { "properties": { "kind": { "enum": ["github_repo", "web_page"] } } },
      "then": { "not": { "required": ["author"] } }
    }
  ]
}
